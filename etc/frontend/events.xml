<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="customer_login">
        <observer name="onetrace_customer_login" instance="OneTrace\Connector\Observer\CustomerChanged"/>
    </event>
    <event name="checkout_cart_product_add_after">
        <observer name="onetrace_cart_added" instance="OneTrace\Connector\Observer\CartAdded"/>
    </event>
    <event name="sales_quote_remove_item">
        <observer name="onetrace_cart_removed" instance="OneTrace\Connector\Observer\CartRemoved"/>
    </event>
    <event name="controller_action_predispatch_checkout_index_index">
        <observer name="onetrace_checkout_started" instance="OneTrace\Connector\Observer\CheckoutStarted"/>
    </event>
    <event name="layout_generate_blocks_after">
        <observer name="onetrace_hide_stock_alert" instance="OneTrace\Connector\Observer\HideStockAlert"/>
        <observer name="onetrace_search_widget_page" instance="OneTrace\Connector\Observer\SearchWidgetPage"/>
    </event>
    <!-- The OneTrace search widget draws the quick search results page. -->
    <event name="layout_load_before">
        <observer name="onetrace_search_widget_page" instance="OneTrace\Connector\Observer\SearchWidgetPage"/>
    </event>
</config>
