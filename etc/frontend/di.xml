<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- /cdp-sw.js: the Web Push service worker must come from the store's own domain.
         ?onetrace_cart=ID:QTY,… on any storefront page: a cart link of OneTrace fills the cart and redirects to it. -->
    <type name="Magento\Framework\App\RouterList">
        <arguments>
            <argument name="routerList" xsi:type="array">
                <item name="onetrace_service_worker" xsi:type="array">
                    <item name="class" xsi:type="string">OneTrace\Connector\Controller\ServiceWorkerRouter</item>
                    <item name="disable" xsi:type="boolean">false</item>
                    <item name="sortOrder" xsi:type="string">5</item>
                </item>
                <item name="onetrace_cart_link" xsi:type="array">
                    <item name="class" xsi:type="string">OneTrace\Connector\Controller\CartLinkRouter</item>
                    <item name="disable" xsi:type="boolean">false</item>
                    <item name="sortOrder" xsi:type="string">4</item>
                </item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\Customer\CustomerData\SectionPoolInterface">
        <arguments>
            <argument name="sectionSourceMap" xsi:type="array">
                <item name="onetrace" xsi:type="string">OneTrace\Connector\CustomerData\Visitor</item>
            </argument>
        </arguments>
    </type>
    <!-- Product search from OneTrace: products of the quick search results ("Product search" setting). -->
    <type name="Magento\Search\Api\SearchInterface">
        <plugin name="onetrace_search" type="OneTrace\Connector\Plugin\Search"/>
    </type>
    <!-- Redirect rules of the platform: the results page of a query with a rule opens the rule's page. -->
    <type name="Magento\CatalogSearch\Controller\Result\Index">
        <plugin name="onetrace_search_redirect" type="OneTrace\Connector\Plugin\SearchRedirect"/>
    </type>
</config>
