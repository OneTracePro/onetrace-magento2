<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="sales_model_service_quote_submit_before">
        <observer name="onetrace_loyalty_to_order" instance="OneTrace\Connector\Observer\LoyaltyToOrder"/>
    </event>
    <event name="sales_model_service_quote_submit_success">
        <observer name="onetrace_order_placed" instance="OneTrace\Connector\Observer\OrderPlaced"/>
        <observer name="onetrace_loyalty_confirm" instance="OneTrace\Connector\Observer\LoyaltyConfirm"/>
        <observer name="onetrace_stock_ordered" instance="OneTrace\Connector\Observer\StockChanged"/>
    </event>
    <event name="sales_order_invoice_pay">
        <observer name="onetrace_order_paid" instance="OneTrace\Connector\Observer\OrderPaid"/>
    </event>
    <event name="order_cancel_after">
        <observer name="onetrace_order_cancelled" instance="OneTrace\Connector\Observer\OrderCancelled"/>
        <observer name="onetrace_stock_cancelled" instance="OneTrace\Connector\Observer\StockChanged"/>
    </event>
    <event name="sales_order_creditmemo_refund">
        <observer name="onetrace_order_refunded" instance="OneTrace\Connector\Observer\OrderRefunded"/>
        <observer name="onetrace_stock_refunded" instance="OneTrace\Connector\Observer\StockChanged"/>
    </event>
    <event name="customer_register_success">
        <observer name="onetrace_customer_registered" instance="OneTrace\Connector\Observer\CustomerChanged"/>
        <observer name="onetrace_referral_registered" instance="OneTrace\Connector\Observer\ReferralRegistered"/>
    </event>
    <event name="customer_save_after_data_object">
        <observer name="onetrace_customer_saved" instance="OneTrace\Connector\Observer\CustomerChanged"/>
    </event>
    <event name="customer_address_save_after">
        <observer name="onetrace_customer_address_saved" instance="OneTrace\Connector\Observer\CustomerChanged"/>
    </event>
    <event name="newsletter_subscriber_save_after">
        <observer name="onetrace_newsletter" instance="OneTrace\Connector\Observer\NewsletterChanged"/>
    </event>
    <event name="catalog_product_save_after">
        <observer name="onetrace_product_saved" instance="OneTrace\Connector\Observer\ProductChanged"/>
    </event>
    <event name="catalog_product_delete_after">
        <observer name="onetrace_product_deleted" instance="OneTrace\Connector\Observer\ProductDeleted"/>
    </event>
    <!-- Stock without MSI: the stock item of the product form, the REST API and imports through the model. -->
    <event name="cataloginventory_stock_item_save_after">
        <observer name="onetrace_stock_saved" instance="OneTrace\Connector\Observer\StockChanged"/>
    </event>
    <!-- Wishlist of Magento (storefront, GraphQL, the admin order form, moving to the cart). -->
    <event name="wishlist_item_save_after">
        <observer name="onetrace_wishlist_added" instance="OneTrace\Connector\Observer\WishlistChanged"/>
    </event>
    <event name="wishlist_item_delete_after">
        <observer name="onetrace_wishlist_removed" instance="OneTrace\Connector\Observer\WishlistChanged"/>
    </event>
</config>
