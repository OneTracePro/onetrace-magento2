<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="onetrace_test" xsi:type="object">OneTrace\Connector\Console\TestCommand</item>
                <item name="onetrace_status" xsi:type="object">OneTrace\Connector\Console\StatusCommand</item>
                <item name="onetrace_flush" xsi:type="object">OneTrace\Connector\Console\FlushCommand</item>
                <item name="onetrace_sync_catalog" xsi:type="object">OneTrace\Connector\Console\SyncCatalogCommand</item>
            </argument>
        </arguments>
    </type>
    <!-- Console commands are built on every bin/magento run: their dependencies are loaded only when they run. -->
    <type name="OneTrace\Connector\Console\TestCommand">
        <arguments>
            <argument name="status" xsi:type="object">OneTrace\Connector\Model\Status\Proxy</argument>
        </arguments>
    </type>
    <type name="OneTrace\Connector\Console\StatusCommand">
        <arguments>
            <argument name="queue" xsi:type="object">OneTrace\Connector\Model\Queue\Proxy</argument>
            <argument name="status" xsi:type="object">OneTrace\Connector\Model\Status\Proxy</argument>
        </arguments>
    </type>
    <type name="OneTrace\Connector\Console\FlushCommand">
        <arguments>
            <argument name="queue" xsi:type="object">OneTrace\Connector\Model\Queue\Proxy</argument>
        </arguments>
    </type>
    <type name="OneTrace\Connector\Console\SyncCatalogCommand">
        <arguments>
            <argument name="sync" xsi:type="object">OneTrace\Connector\Model\CatalogSync\Proxy</argument>
            <argument name="queue" xsi:type="object">OneTrace\Connector\Model\Queue\Proxy</argument>
        </arguments>
    </type>
    <type name="Magento\Config\Model\Config\TypePool">
        <arguments>
            <argument name="sensitive" xsi:type="array">
                <item name="onetrace/connection/secret_key" xsi:type="string">1</item>
            </argument>
        </arguments>
    </type>
    <!-- Bonus points: the hold is checked right before the order is placed. -->
    <type name="Magento\Quote\Api\CartManagementInterface">
        <plugin name="onetrace_prepare_loyalty" type="OneTrace\Connector\Plugin\PrepareLoyalty"/>
    </type>
    <!-- Wishlist events also come from the admin, GraphQL and cron: the customer session only on the storefront. -->
    <type name="OneTrace\Connector\Model\Wishlist">
        <arguments>
            <argument name="session" xsi:type="object">Magento\Customer\Model\Session\Proxy</argument>
        </arguments>
    </type>
    <!-- Inventory (MSI): changed source items change the salable quantity of the catalog. -->
    <type name="Magento\InventoryApi\Api\SourceItemsSaveInterface">
        <plugin name="onetrace_source_items" type="OneTrace\Connector\Plugin\SourceItemsChanged"/>
    </type>
    <type name="Magento\InventoryApi\Api\SourceItemsDeleteInterface">
        <plugin name="onetrace_source_items" type="OneTrace\Connector\Plugin\SourceItemsChanged"/>
    </type>
    <!-- Store emails through OneTrace: the template of an email for its transport, and the transport itself. The
         plugin runs first (sortOrder below Magento's "Disable Email Communications" and SMTP extensions): what OneTrace
         does not accept goes on through them. -->
    <type name="Magento\Framework\Mail\Template\TransportBuilder">
        <plugin name="onetrace_email_context" type="OneTrace\Connector\Plugin\EmailContext"/>
    </type>
    <type name="Magento\Framework\Mail\TransportInterface">
        <plugin name="onetrace_store_emails" type="OneTrace\Connector\Plugin\SendThroughOneTrace" sortOrder="-100"/>
    </type>
    <!-- Storefront links in emails sent from the admin and cron. -->
    <virtualType name="OneTrace\Connector\Model\Email\FrontendUrlFactory" type="Magento\Framework\UrlFactory">
        <arguments>
            <argument name="instanceName" xsi:type="string">Magento\Framework\Url</argument>
        </arguments>
    </virtualType>
    <type name="OneTrace\Connector\Model\Email\OrderData">
        <arguments>
            <argument name="urlFactory" xsi:type="object">OneTrace\Connector\Model\Email\FrontendUrlFactory</argument>
        </arguments>
    </type>
</config>
