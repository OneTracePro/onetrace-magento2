<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <job name="onetrace_flush" instance="OneTrace\Connector\Cron\Flush" method="execute">
            <schedule>* * * * *</schedule>
        </job>
        <job name="onetrace_daily_catalog" instance="OneTrace\Connector\Cron\DailyCatalog" method="execute">
            <schedule>17 3 * * *</schedule>
        </job>
    </group>
</config>
