<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <onetrace>
            <connection>
                <url/>
                <write_key/>
                <secret_key backend_model="Magento\Config\Model\Config\Backend\Encrypted"/>
            </connection>
            <parts>
                <tracker>1</tracker>
                <wait_for_consent>1</wait_for_consent>
                <orders>1</orders>
                <delivered_statuses/>
                <cart>1</cart>
                <catalog>1</catalog>
                <newsletter>1</newsletter>
                <search>0</search>
                <loyalty>0</loyalty>
                <referral_field>0</referral_field>
                <notify>1</notify>
            </parts>
            <consent>
                <topic/>
            </consent>
            <widgets>
                <product/>
                <cart/>
                <push>0</push>
            </widgets>
            <store_mcp>
                <enabled>0</enabled>
                <tools>store_start_verification,store_verify,store_get_customer,store_find_orders,store_get_order,store_get_tracking,store_check_availability,store_get_delivery_options,store_get_return_policy</tools>
                <return_page/>
                <code_identity>general</code_identity>
                <code_template>onetrace_store_mcp_code_template</code_template>
                <request_identity>sales</request_identity>
                <request_template>onetrace_store_mcp_request_template</request_template>
            </store_mcp>
            <promo>
                <pools/>
            </promo>
        </onetrace>
    </default>
</config>
