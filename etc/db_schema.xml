<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <!-- Outgoing queue: messages and catalog changes are sent in batches by cron, the store never waits for the platform. -->
    <table name="onetrace_queue" resource="default" engine="innodb" comment="OneTrace outgoing queue">
        <column xsi:type="bigint" name="id" unsigned="true" nullable="false" identity="true"/>
        <column xsi:type="smallint" name="store_id" unsigned="true" nullable="false" default="0"/>
        <column xsi:type="varchar" name="kind" nullable="false" length="16"/>
        <column xsi:type="varchar" name="item_key" nullable="false" length="191" default=""/>
        <column xsi:type="mediumtext" name="payload" nullable="false"/>
        <column xsi:type="smallint" name="attempts" unsigned="true" nullable="false" default="0"/>
        <column xsi:type="datetime" name="available_at" nullable="false"/>
        <column xsi:type="text" name="last_error" nullable="true"/>
        <column xsi:type="datetime" name="created_at" nullable="false"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="id"/>
        </constraint>
        <index referenceId="ONETRACE_QUEUE_KIND_AVAILABLE" indexType="btree">
            <column name="kind"/>
            <column name="available_at"/>
        </index>
        <index referenceId="ONETRACE_QUEUE_STORE_ITEM_KEY" indexType="btree">
            <column name="store_id"/>
            <column name="item_key"/>
        </index>
    </table>
    <!-- The visitor's tracker id of an order: later order events land in the same profile as the order. -->
    <table name="onetrace_order" resource="default" engine="innodb" comment="OneTrace order visitor">
        <column xsi:type="int" name="order_id" unsigned="true" nullable="false"/>
        <column xsi:type="varchar" name="anonymous_id" nullable="false" length="255"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="order_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="ONETRACE_ORDER_ORDER_ID_SALES_ORDER_ENTITY_ID" table="onetrace_order" column="order_id" referenceTable="sales_order" referenceColumn="entity_id" onDelete="CASCADE"/>
    </table>
    <!-- Bonus points of the OneTrace loyalty program: the hold of the cart, the discount in the totals of the quote,
         order, invoice and credit memo, the confirmation of the order. -->
    <table name="quote" resource="checkout">
        <column xsi:type="int" name="onetrace_loyalty_points" unsigned="true" nullable="false" default="0" comment="OneTrace: held bonus points"/>
        <column xsi:type="decimal" name="onetrace_loyalty_discount" scale="4" precision="20" unsigned="false" nullable="false" default="0" comment="OneTrace: discount of the held points"/>
        <column xsi:type="decimal" name="base_onetrace_loyalty_discount" scale="4" precision="20" unsigned="false" nullable="false" default="0" comment="OneTrace: discount of the held points, base currency"/>
        <column xsi:type="varchar" name="onetrace_loyalty_redemption" nullable="true" length="64" comment="OneTrace: redemption id"/>
        <column xsi:type="decimal" name="onetrace_loyalty_basis" scale="4" precision="20" unsigned="false" nullable="false" default="0" comment="OneTrace: cart amount at the hold"/>
        <column xsi:type="decimal" name="onetrace_loyalty_ratio" scale="4" precision="12" unsigned="false" nullable="false" default="0" comment="OneTrace: share of the cart payable with points"/>
        <column xsi:type="int" name="onetrace_loyalty_held_until" unsigned="true" nullable="false" default="0" comment="OneTrace: hold expiry, unix time"/>
    </table>
    <!-- The total of the address (like discount_amount): reading the cart totals takes "{code}_amount" from here. -->
    <table name="quote_address" resource="checkout">
        <column xsi:type="decimal" name="onetrace_loyalty_amount" scale="4" precision="20" unsigned="false" nullable="false" default="0" comment="OneTrace: bonus points total (negative)"/>
        <column xsi:type="decimal" name="base_onetrace_loyalty_amount" scale="4" precision="20" unsigned="false" nullable="false" default="0" comment="OneTrace: bonus points total (negative), base currency"/>
    </table>
    <table name="sales_order" resource="sales">
        <column xsi:type="int" name="onetrace_loyalty_points" unsigned="true" nullable="false" default="0" comment="OneTrace: held bonus points"/>
        <column xsi:type="decimal" name="onetrace_loyalty_discount" scale="4" precision="20" unsigned="false" nullable="false" default="0" comment="OneTrace: discount of the held points"/>
        <column xsi:type="decimal" name="base_onetrace_loyalty_discount" scale="4" precision="20" unsigned="false" nullable="false" default="0" comment="OneTrace: discount of the held points, base currency"/>
        <column xsi:type="varchar" name="onetrace_loyalty_redemption" nullable="true" length="64" comment="OneTrace: redemption id"/>
        <column xsi:type="datetime" name="onetrace_loyalty_confirmed_at" nullable="true" comment="OneTrace: redemption confirmed"/>
        <column xsi:type="datetime" name="onetrace_delivered_at" nullable="true" comment="OneTrace: order_delivered sent"/>
    </table>
    <!-- order_shipped once per shipment: 0 — made before the module, 1 — waits for a tracking number, 2 — sent. -->
    <table name="sales_shipment" resource="sales">
        <column xsi:type="smallint" name="onetrace_shipped" unsigned="true" nullable="false" default="0" comment="OneTrace: order_shipped state"/>
    </table>
    <table name="sales_invoice" resource="sales">
        <column xsi:type="decimal" name="onetrace_loyalty_discount" scale="4" precision="20" unsigned="false" nullable="false" default="0" comment="OneTrace: bonus points discount"/>
        <column xsi:type="decimal" name="base_onetrace_loyalty_discount" scale="4" precision="20" unsigned="false" nullable="false" default="0" comment="OneTrace: bonus points discount, base currency"/>
    </table>
    <table name="sales_creditmemo" resource="sales">
        <column xsi:type="decimal" name="onetrace_loyalty_discount" scale="4" precision="20" unsigned="false" nullable="false" default="0" comment="OneTrace: bonus points discount"/>
        <column xsi:type="decimal" name="base_onetrace_loyalty_discount" scale="4" precision="20" unsigned="false" nullable="false" default="0" comment="OneTrace: bonus points discount, base currency"/>
    </table>
</schema>
