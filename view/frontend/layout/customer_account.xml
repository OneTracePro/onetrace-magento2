<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="customer_account_navigation">
            <block class="Magento\Customer\Block\Account\SortLink" name="onetrace-loyalty-link" ifconfig="onetrace/parts/loyalty">
                <arguments>
                    <argument name="path" xsi:type="string">onetrace/loyalty</argument>
                    <argument name="label" xsi:type="string" translate="true">Bonus points</argument>
                    <argument name="sortOrder" xsi:type="number">215</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
